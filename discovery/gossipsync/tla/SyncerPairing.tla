---------------------------- MODULE SyncerPairing ----------------------------
(***************************************************************************)
(* SyncerPairing states the contract of one peer syncer's historical sync  *)
(* in discovery/gossipsync: the Idle, AwaitingRange, QueryingSCIDs and     *)
(* Draining states of syncer_states.go, and the reply accumulator of       *)
(* range_reply.go. It is the TLA+ sibling of pmodel/src/syncer.p, and      *)
(* SPEC.md section 7 is the prose version of what it checks.               *)
(*                                                                         *)
(* The module has two processes. The syncer is the component under         *)
(* contract. The world is everything around it: the peer, the link, the    *)
(* timeout actor and the manager. The world owns every nondeterministic    *)
(* choice, and TLC explores every one of them, so each property below      *)
(* holds in every reachable state at the chosen scope, not only on sampled *)
(* schedules as in the P models.                                           *)
(*                                                                         *)
(* A module is read top to bottom. Constants come first, then plain        *)
(* definitions that need no variables, then the PlusCal algorithm inside a *)
(* comment, then the TLA+ that the PlusCal translator writes from it, and  *)
(* last the properties TLC checks. Only the algorithm and the properties   *)
(* are written by hand; the translation between the BEGIN and END          *)
(* TRANSLATION markers is generated by pcal.trans and must not be edited.  *)
(***************************************************************************)
EXTENDS Integers, Sequences, FiniteSets, TLC

(***************************************************************************)
(* CONSTANTS are the parameters of the model. A .cfg file gives each one a *)
(* value, and that choice is the scope of the check.                       *)
(*                                                                         *)
(*   NumBlocks    the abstract blocks of the chain; a range query always   *)
(*                covers all of them.                                      *)
(*   MaxAttempts  how many attempts the manager starts, refused ones       *)
(*                included.                                                *)
(*   MaxBatches   the most query_short_channel_ids batches a completed     *)
(*                range phase leads to.                                    *)
(*   MaxReplies   the reply budget of one stream, MaxReplies in the Go.    *)
(*   MaxPauses    the timing profile: how many long pauses, pauses longer  *)
(*                than the timeout, the peer may take in one stream.       *)
(*   Stalls       whether the peer may stop answering a query partway.     *)
(*   MaxDups, MaxCorrupts  a byzantine peer's budget of duplicated and     *)
(*                corrupted replies.                                       *)
(*   Format       "lnd", or "legacy" for a peer that echoes the whole      *)
(*                query in every reply.                                    *)
(*   CompleteEveryReply  a non-conforming peer that sets complete on every *)
(*                reply, the scenario of open question Q8.                 *)
(*                                                                         *)
(* The last four constants each remove one rule of the production syncer,  *)
(* for the configurations that must produce a counterexample:              *)
(*                                                                         *)
(*   NoDraining              a failed attempt goes straight back to Idle.  *)
(*   NoFirstReplyCheck       the first reply may start after block zero.   *)
(*   LegacyDrainOnLastBlock  Draining ends a legacy stream on the first    *)
(*                           reply that covers the last block, which every *)
(*                           legacy reply does.                            *)
(*   FixedDrainDeadline      an absorbed reply doesn't re-arm the drain    *)
(*                           timer, so it is a deadline from abandonment.  *)
(***************************************************************************)
CONSTANTS
    NumBlocks, MaxAttempts, MaxBatches, MaxReplies, MaxPauses,
    Stalls, MaxDups, MaxCorrupts, Format, CompleteEveryReply,
    NoDraining, NoFirstReplyCheck, LegacyDrainOnLastBlock, FixedDrainDeadline

ASSUME /\ NumBlocks \in Nat \ {0}
       /\ Format \in {"lnd", "legacy"}

LastBlock == NumBlocks - 1

(***************************************************************************)
(* Every query gets a ghost ID that exists only in the model, never on the *)
(* wire. The syncer sends at most one range query and MaxBatches SCID      *)
(* queries per attempt, which bounds the IDs.                              *)
(***************************************************************************)
MaxQid == MaxAttempts * (1 + MaxBatches)

(***************************************************************************)
(* An honest peer answers a range query with replies that tile the chain:  *)
(* contiguous block ranges from block zero to the last block. Tile(f, C)   *)
(* is the tiling of blocks f to LastBlock that starts a new reply at every *)
(* cut in C. RECURSIVE is how TLA+ declares an operator that calls itself, *)
(* and CHOOSE picks the one value that satisfies its condition, here the   *)
(* smallest cut after f.                                                   *)
(***************************************************************************)
RECURSIVE Tile(_, _)
Tile(f, cuts) ==
    IF \E c \in cuts : c > f
    THEN LET c == CHOOSE c \in cuts : c > f /\ \A d \in cuts : d > f => c <= d
         IN  <<[first |-> f, last |-> c - 1]>> \o Tile(c, cuts)
    ELSE <<[first |-> f, last |-> LastBlock]>>

\* Every way to split the chain into replies. With three blocks there are
\* four: one reply, two replies either way, or one reply per block.
Tilings == {Tile(0, C) : C \in SUBSET (1..LastBlock)}

(***************************************************************************)
(* A message from the peer is a record. A range reply covers blocks        *)
(* [first, last] and may set complete. An SCID query's answer is a single  *)
(* end marker. bad marks a reply a byzantine peer corrupted, which never   *)
(* lines up with any query. q and i are ghost tags: the query the message  *)
(* answers and its place in that stream. The properties use them to say    *)
(* what the wire can't, which attempt a reply really belongs to.           *)
(***************************************************************************)
EndMsg(q) ==
    [isEnd |-> TRUE, first |-> 0, last |-> 0, complete |-> TRUE,
     bad |-> FALSE, q |-> q, i |-> 0]

NoMsg == EndMsg(0)

(***************************************************************************)
(* The syncer reads its mailbox one event at a time. The world hands it    *)
(* one event in the variable ev and waits until the syncer has handled it, *)
(* since an actor handles one message at a time and carries out its        *)
(* outbox at once. Every event has the same fields so that TLC can compare *)
(* any two of them.                                                        *)
(***************************************************************************)
NoEvent == [kind |-> "none", attempt |-> 0, seq |-> 0, msg |-> NoMsg]

(***************************************************************************)
(* A syncer state is a record, like the Go state values: each state keeps  *)
(* only the fields it needs, and every other field holds a fixed default.  *)
(* That matters to TLC as much as to a reader: two states that differ only *)
(* in a field nobody reads would otherwise count as two distinct states.   *)
(*                                                                         *)
(*   att, qid    the attempt in flight and its outstanding query.          *)
(*   prevLast    the last block of the previous reply, or -1.              *)
(*   used        the reply budget spent.                                   *)
(*   cr          the ghost tags of the replies credited so far, the part   *)
(*               of the accumulator only the model can see.                *)
(*   pending     the SCID batches still to query after the current one.    *)
(*   drainRange  whether Draining absorbs a range stream or an end marker. *)
(*   absorbed    the replies Draining has absorbed.                        *)
(***************************************************************************)
IdleState ==
    [st |-> "Idle", att |-> 0, qid |-> 0, prevLast |-> -1, used |-> 0,
     cr |-> <<>>, pending |-> 0, drainRange |-> FALSE, absorbed |-> 0]

AwaitingRangeState(a, q) ==
    [IdleState EXCEPT !.st = "AwaitingRange", !.att = a, !.qid = q]

QueryingSCIDsState(a, q, p) ==
    [IdleState EXCEPT !.st = "QueryingSCIDs", !.att = a, !.qid = q,
                      !.pending = p]

DrainingState(isRange) ==
    [IdleState EXCEPT !.st = "Draining", !.drainRange = isRange]

\* A reply echoes the whole query, as an old lnd peer's replies do. A
\* corrupted reply never does.
IsLegacy(m) == ~m.bad /\ m.first = 0 /\ m.last = LastBlock

(***************************************************************************)
(* Valid is the accumulator's range check (checkRange in range_reply.go).  *)
(* A legacy reply skips it. Any other reply must start at block zero if it *)
(* is the first of its stream, and on the block after the previous reply   *)
(* otherwise. The model has one channel per block, so a reply that         *)
(* continues the previous reply's last block, which Go also accepts, never *)
(* occurs.                                                                 *)
(***************************************************************************)
Valid(s, m) ==
    \/ IsLegacy(m)
    \/ /\ ~m.bad
       /\ IF s.prevLast < 0
          THEN m.first = 0 \/ NoFirstReplyCheck
          ELSE m.first = s.prevLast + 1

\* Fold is the accumulator after it takes reply m.
Fold(s, m) ==
    [s EXCEPT !.cr = Append(@, [q |-> m.q, i |-> m.i]),
              !.used = @ + 1,
              !.prevLast = m.last]

\* RangeDone is complete in range_reply.go, applied to the folded
\* accumulator: the budget is spent, or the stream ended.
RangeDone(acc, m) ==
    \/ acc.used >= MaxReplies
    \/ IF IsLegacy(m) THEN m.complete ELSE m.last >= LastBlock

\* DrainEnds is the rule by which Draining ends an abandoned range stream.
DrainEnds(s, m) ==
    \/ m.complete
    \/ (~IsLegacy(m) \/ LegacyDrainOnLastBlock) /\ m.last >= LastBlock
    \/ s.absorbed + 1 >= MaxReplies

(***************************************************************************)
(* The algorithm below is PlusCal, in its C-like syntax. PlusCal looks     *)
(* like a programming language, but it is only a more familiar way to      *)
(* write a TLA+ spec: the translator turns it into an initial predicate    *)
(* and a next-state relation. The pieces to know:                          *)
(*                                                                         *)
(*   variables  the state. "x \in S" starts x at every element of S, so    *)
(*              TLC explores one initial state per choice.                 *)
(*   process    a thread of control. Processes interleave one step at a    *)
(*              time, in every order.                                      *)
(*   label      a name followed by a colon. Everything from one label to   *)
(*              the next is a single atomic step. Here each process has    *)
(*              one label, so each loop iteration is one step.             *)
(*   await      the step can only happen when the condition holds.         *)
(*   either/or  the step does any one of the branches. TLC tries all.      *)
(*   with       binds a name to a value, or, with "\in", to any element    *)
(*              of a set. TLC tries all.                                   *)
(*   macro      text substitution, like a C macro, with no step of its     *)
(*              own.                                                       *)
(*   fair       the process can't stop taking steps forever while it has   *)
(*              one enabled. That is weak fairness, and it only matters to *)
(*              the liveness property at the end.                          *)
(*                                                                         *)
(* Within one step, a later statement sees what an earlier one assigned,   *)
(* as in Go, but a variable may be assigned only once per step.            *)
(***************************************************************************)

(* --algorithm SyncerPairing {

variables
    \* The peer's view of the chain is fixed for a behavior, but TLC starts
    \* one behavior for every tiling, every number of SCID batches, and both
    \* outcomes of our local lookup.
    tiling \in Tilings,
    batches \in 0..MaxBatches,
    lookupErr \in BOOLEAN,

    \* The link holds the peer's messages in flight, in order. pauses counts
    \* the long pauses the peer took in each query's stream.
    link = <<>>,
    pauses = [q \in 1..MaxQid |-> 0],

    \* The timeout actor: the last timer armed, and whether it is still
    \* armed. lateFired bounds the stale fires the world may deliver.
    timer = [armed |-> FALSE, seq |-> 0, drain |-> FALSE],
    lateFired = 0,

    \* The event being handed to the syncer, and the world's budgets.
    ev = NoEvent,
    started = 0,
    dups = 0,
    corrupts = 0,

    \* The syncer: its state, plus the two counters every Go state carries
    \* in common. nextQid is ghost; timerSeq is the real timer sequence.
    sy = IdleState,
    nextQid = 0,
    timerSeq = 0,

    \* A ghost record of every outcome the syncer reported, by attempt.
    outcomes = [a \in 1..MaxAttempts |-> <<>>];

define {
    \* The honest stream that answers range query q.
    RangeStream(q) ==
        [k \in 1..Len(tiling) |->
            [isEnd    |-> FALSE,
             first    |-> IF Format = "legacy" THEN 0 ELSE tiling[k].first,
             last     |-> IF Format = "legacy" THEN LastBlock
                                               ELSE tiling[k].last,
             complete |-> k = Len(tiling) \/ CompleteEveryReply,
             bad      |-> FALSE,
             q        |-> q,
             i        |-> k - 1]]

    (***********************************************************************)
    (* Both timers are inactivity timers with the same timeout, so a timer *)
    (* can fire with messages still on the link only if the peer paused    *)
    (* longer than the timeout before the next one: a long pause. With the *)
    (* link empty the peer has sent all it will, and the timer may always  *)
    (* fire. MaxPauses bounds the long pauses per stream. A fixed drain    *)
    (* deadline, which a prompt stream can outlast, may fire at any time.  *)
    (*                                                                     *)
    (* The IF matters. Inside an action TLC evaluates every disjunct of a  *)
    (* \/ as a separate branch, so a disjunction would apply Head to an    *)
    (* empty link.                                                         *)
    (***********************************************************************)
    TimerMayFire ==
        IF link = <<>> THEN TRUE
        ELSE \/ FixedDrainDeadline /\ timer.drain
             \/ pauses[Head(link).q] < MaxPauses
}

\* Arm bumps the timer sequence and arms a timer with the new number.
macro Arm(isDrain) {
    timerSeq := timerSeq + 1;
    timer := [armed |-> TRUE, seq |-> timerSeq, drain |-> isDrain];
}

\* Report is the ReportOutcome effect, recorded in the ghost ledger.
macro Report(a, kind) {
    outcomes[a] := Append(outcomes[a], kind);
}

\* GoIdle returns to Idle and disarms the timer.
macro GoIdle() {
    sy := IdleState;
    timer.armed := FALSE;
}

\* Sending a query puts the peer's whole answer on the link at once. That
\* folds the peer's think time into the link delay, which the timing profile
\* already covers.
macro SendRange() {
    nextQid := nextQid + 1;
    link := link \o RangeStream(nextQid);
}

macro SendSCIDs() {
    nextQid := nextQid + 1;
    link := Append(link, EndMsg(nextQid));
}

\* Abandon fails the attempt and drains the rest of the abandoned exchange.
\* Report reads sy before GoIdle or the assignment to sy replaces it.
macro Abandon(isRange) {
    Report(sy.att, "peerFault");
    if (NoDraining) {
        GoIdle();
    } else {
        sy := DrainingState(isRange);
        Arm(TRUE);
    };
}

\* OnReply is AwaitingRange taking a range reply.
macro OnReply(m) {
    if (~Valid(sy, m)) {
        Abandon(TRUE);
    } else {
        with (acc = Fold(sy, m)) {
            if (~RangeDone(acc, m)) {
                sy := acc;
                Arm(FALSE);
            } else if (lookupErr) {
                Report(sy.att, "localFault");
                GoIdle();
            } else if (batches = 0) {
                Report(sy.att, "completed");
                GoIdle();
            } else {
                SendSCIDs();
                sy := QueryingSCIDsState(sy.att, nextQid, batches - 1);
                Arm(FALSE);
            };
        };
    };
}

\* OnEnd is QueryingSCIDs taking an end marker.
macro OnEnd() {
    if (sy.pending = 0) {
        Report(sy.att, "completed");
        GoIdle();
    } else {
        SendSCIDs();
        sy := [sy EXCEPT !.qid = nextQid, !.pending = @ - 1];
        Arm(FALSE);
    };
}

\* OnDrain is Draining taking any message from the peer.
macro OnDrain(m) {
    if (m.isEnd) {
        if (~sy.drainRange) {
            GoIdle();
        };
    } else if (sy.drainRange) {
        if (DrainEnds(sy, m)) {
            GoIdle();
        } else {
            sy.absorbed := sy.absorbed + 1;
            if (~FixedDrainDeadline) {
                Arm(TRUE);
            };
        };
    };
}

\* The syncer handles one event per step. Anything a state doesn't expect,
\* an unsolicited reply or a stale timer, falls through every branch and
\* changes nothing.
fair process (Syncer = "syncer") {
handle:
    while (TRUE) {
        await ev /= NoEvent;
        if (ev.kind = "start") {
            if (sy.st = "Idle") {
                SendRange();
                sy := AwaitingRangeState(ev.attempt, nextQid);
                Arm(FALSE);
            } else {
                Report(ev.attempt, "busy");
            };
        } else if (ev.kind = "timer") {
            if (sy.st /= "Idle" /\ ev.seq = timerSeq) {
                if (sy.st = "AwaitingRange") {
                    Abandon(TRUE);
                } else if (sy.st = "QueryingSCIDs") {
                    Abandon(FALSE);
                } else {
                    GoIdle();
                };
            };
        } else {
            with (m = ev.msg) {
                if (sy.st = "AwaitingRange" /\ ~m.isEnd) {
                    OnReply(m);
                } else if (sy.st = "QueryingSCIDs" /\ m.isEnd) {
                    OnEnd();
                } else if (sy.st = "Draining") {
                    OnDrain(m);
                };
            };
        };
        ev := NoEvent;
    }
}

\* The world takes one action per step, whenever the syncer is free. Every
\* action consumes a bounded resource, so every behavior of the world is
\* finite, and it ends with the link empty and no timer armed.
fair process (World = "world") {
act:
    while (TRUE) {
        await ev = NoEvent;
        either {
            \* The manager starts an attempt.
            await started < MaxAttempts;
            started := started + 1;
            ev := [NoEvent EXCEPT !.kind = "start", !.attempt = started];
        } or {
            \* The link delivers its next message.
            await link /= <<>>;
            ev := [NoEvent EXCEPT !.kind = "msg", !.msg = Head(link)];
            link := Tail(link);
        } or {
            \* The peer stops answering the query at the head of the link.
            \* SelectSeq keeps the elements that pass the test, and LAMBDA
            \* writes the test inline.
            await Stalls /\ link /= <<>>;
            link := SelectSeq(link, LAMBDA x : x.q /= Head(link).q);
        } or {
            \* The armed timer fires, if the timing profile allows it. A
            \* fire with messages still on the link is a long pause.
            await timer.armed /\ TimerMayFire;
            if (link /= <<>>) {
                pauses[Head(link).q] := pauses[Head(link).q] + 1;
            };
            ev := [NoEvent EXCEPT !.kind = "timer", !.seq = timer.seq];
            timer.armed := FALSE;
        } or {
            \* A stale fire: an older timer, or a disarmed one whose fire
            \* raced its cancellation.
            with (s \in (lateFired + 1)..timerSeq) {
                await ~(timer.armed /\ s = timer.seq);
                lateFired := s;
                ev := [NoEvent EXCEPT !.kind = "timer", !.seq = s];
            };
        } or {
            \* A byzantine peer sends the head message twice.
            await dups < MaxDups /\ link /= <<>>;
            dups := dups + 1;
            link := <<Head(link)>> \o link;
        } or {
            \* A byzantine peer corrupts the head reply.
            await corrupts < MaxCorrupts /\ link /= <<>>;
            await ~Head(link).isEnd /\ ~Head(link).bad;
            corrupts := corrupts + 1;
            link := [link EXCEPT ![1].bad = TRUE];
        };
    }
}

} *)
\* BEGIN TRANSLATION
VARIABLES tiling, batches, lookupErr, link, pauses, timer, lateFired, ev, 
          started, dups, corrupts, sy, nextQid, timerSeq, outcomes

(* define statement *)
RangeStream(q) ==
    [k \in 1..Len(tiling) |->
        [isEnd    |-> FALSE,
         first    |-> IF Format = "legacy" THEN 0 ELSE tiling[k].first,
         last     |-> IF Format = "legacy" THEN LastBlock
                                           ELSE tiling[k].last,
         complete |-> k = Len(tiling) \/ CompleteEveryReply,
         bad      |-> FALSE,
         q        |-> q,
         i        |-> k - 1]]













TimerMayFire ==
    IF link = <<>> THEN TRUE
    ELSE \/ FixedDrainDeadline /\ timer.drain
         \/ pauses[Head(link).q] < MaxPauses


vars == << tiling, batches, lookupErr, link, pauses, timer, lateFired, ev, 
           started, dups, corrupts, sy, nextQid, timerSeq, outcomes >>

ProcSet == {"syncer"} \cup {"world"}

Init == (* Global variables *)
        /\ tiling \in Tilings
        /\ batches \in 0..MaxBatches
        /\ lookupErr \in BOOLEAN
        /\ link = <<>>
        /\ pauses = [q \in 1..MaxQid |-> 0]
        /\ timer = [armed |-> FALSE, seq |-> 0, drain |-> FALSE]
        /\ lateFired = 0
        /\ ev = NoEvent
        /\ started = 0
        /\ dups = 0
        /\ corrupts = 0
        /\ sy = IdleState
        /\ nextQid = 0
        /\ timerSeq = 0
        /\ outcomes = [a \in 1..MaxAttempts |-> <<>>]

Syncer == /\ ev /= NoEvent
          /\ IF ev.kind = "start"
                THEN /\ IF sy.st = "Idle"
                           THEN /\ nextQid' = nextQid + 1
                                /\ link' = link \o RangeStream(nextQid')
                                /\ sy' = AwaitingRangeState(ev.attempt, nextQid')
                                /\ timerSeq' = timerSeq + 1
                                /\ timer' = [armed |-> TRUE, seq |-> timerSeq', drain |-> FALSE]
                                /\ UNCHANGED outcomes
                           ELSE /\ outcomes' = [outcomes EXCEPT ![(ev.attempt)] = Append(outcomes[(ev.attempt)], "busy")]
                                /\ UNCHANGED << link, timer, sy, nextQid, 
                                                timerSeq >>
                ELSE /\ IF ev.kind = "timer"
                           THEN /\ IF sy.st /= "Idle" /\ ev.seq = timerSeq
                                      THEN /\ IF sy.st = "AwaitingRange"
                                                 THEN /\ outcomes' = [outcomes EXCEPT ![(sy.att)] = Append(outcomes[(sy.att)], "peerFault")]
                                                      /\ IF NoDraining
                                                            THEN /\ sy' = IdleState
                                                                 /\ timer' = [timer EXCEPT !.armed = FALSE]
                                                                 /\ UNCHANGED timerSeq
                                                            ELSE /\ sy' = DrainingState(TRUE)
                                                                 /\ timerSeq' = timerSeq + 1
                                                                 /\ timer' = [armed |-> TRUE, seq |-> timerSeq', drain |-> TRUE]
                                                 ELSE /\ IF sy.st = "QueryingSCIDs"
                                                            THEN /\ outcomes' = [outcomes EXCEPT ![(sy.att)] = Append(outcomes[(sy.att)], "peerFault")]
                                                                 /\ IF NoDraining
                                                                       THEN /\ sy' = IdleState
                                                                            /\ timer' = [timer EXCEPT !.armed = FALSE]
                                                                            /\ UNCHANGED timerSeq
                                                                       ELSE /\ sy' = DrainingState(FALSE)
                                                                            /\ timerSeq' = timerSeq + 1
                                                                            /\ timer' = [armed |-> TRUE, seq |-> timerSeq', drain |-> TRUE]
                                                            ELSE /\ sy' = IdleState
                                                                 /\ timer' = [timer EXCEPT !.armed = FALSE]
                                                                 /\ UNCHANGED << timerSeq, 
                                                                                 outcomes >>
                                      ELSE /\ TRUE
                                           /\ UNCHANGED << timer, sy, timerSeq, 
                                                           outcomes >>
                                /\ UNCHANGED << link, nextQid >>
                           ELSE /\ LET m == ev.msg IN
                                     IF sy.st = "AwaitingRange" /\ ~m.isEnd
                                        THEN /\ IF ~Valid(sy, m)
                                                   THEN /\ outcomes' = [outcomes EXCEPT ![(sy.att)] = Append(outcomes[(sy.att)], "peerFault")]
                                                        /\ IF NoDraining
                                                              THEN /\ sy' = IdleState
                                                                   /\ timer' = [timer EXCEPT !.armed = FALSE]
                                                                   /\ UNCHANGED timerSeq
                                                              ELSE /\ sy' = DrainingState(TRUE)
                                                                   /\ timerSeq' = timerSeq + 1
                                                                   /\ timer' = [armed |-> TRUE, seq |-> timerSeq', drain |-> TRUE]
                                                        /\ UNCHANGED << link, 
                                                                        nextQid >>
                                                   ELSE /\ LET acc == Fold(sy, m) IN
                                                             IF ~RangeDone(acc, m)
                                                                THEN /\ sy' = acc
                                                                     /\ timerSeq' = timerSeq + 1
                                                                     /\ timer' = [armed |-> TRUE, seq |-> timerSeq', drain |-> FALSE]
                                                                     /\ UNCHANGED << link, 
                                                                                     nextQid, 
                                                                                     outcomes >>
                                                                ELSE /\ IF lookupErr
                                                                           THEN /\ outcomes' = [outcomes EXCEPT ![(sy.att)] = Append(outcomes[(sy.att)], "localFault")]
                                                                                /\ sy' = IdleState
                                                                                /\ timer' = [timer EXCEPT !.armed = FALSE]
                                                                                /\ UNCHANGED << link, 
                                                                                                nextQid, 
                                                                                                timerSeq >>
                                                                           ELSE /\ IF batches = 0
                                                                                      THEN /\ outcomes' = [outcomes EXCEPT ![(sy.att)] = Append(outcomes[(sy.att)], "completed")]
                                                                                           /\ sy' = IdleState
                                                                                           /\ timer' = [timer EXCEPT !.armed = FALSE]
                                                                                           /\ UNCHANGED << link, 
                                                                                                           nextQid, 
                                                                                                           timerSeq >>
                                                                                      ELSE /\ nextQid' = nextQid + 1
                                                                                           /\ link' = Append(link, EndMsg(nextQid'))
                                                                                           /\ sy' = QueryingSCIDsState(sy.att, nextQid', batches - 1)
                                                                                           /\ timerSeq' = timerSeq + 1
                                                                                           /\ timer' = [armed |-> TRUE, seq |-> timerSeq', drain |-> FALSE]
                                                                                           /\ UNCHANGED outcomes
                                        ELSE /\ IF sy.st = "QueryingSCIDs" /\ m.isEnd
                                                   THEN /\ IF sy.pending = 0
                                                              THEN /\ outcomes' = [outcomes EXCEPT ![(sy.att)] = Append(outcomes[(sy.att)], "completed")]
                                                                   /\ sy' = IdleState
                                                                   /\ timer' = [timer EXCEPT !.armed = FALSE]
                                                                   /\ UNCHANGED << link, 
                                                                                   nextQid, 
                                                                                   timerSeq >>
                                                              ELSE /\ nextQid' = nextQid + 1
                                                                   /\ link' = Append(link, EndMsg(nextQid'))
                                                                   /\ sy' = [sy EXCEPT !.qid = nextQid', !.pending = @ - 1]
                                                                   /\ timerSeq' = timerSeq + 1
                                                                   /\ timer' = [armed |-> TRUE, seq |-> timerSeq', drain |-> FALSE]
                                                                   /\ UNCHANGED outcomes
                                                   ELSE /\ IF sy.st = "Draining"
                                                              THEN /\ IF m.isEnd
                                                                         THEN /\ IF ~sy.drainRange
                                                                                    THEN /\ sy' = IdleState
                                                                                         /\ timer' = [timer EXCEPT !.armed = FALSE]
                                                                                    ELSE /\ TRUE
                                                                                         /\ UNCHANGED << timer, 
                                                                                                         sy >>
                                                                              /\ UNCHANGED timerSeq
                                                                         ELSE /\ IF sy.drainRange
                                                                                    THEN /\ IF DrainEnds(sy, m)
                                                                                               THEN /\ sy' = IdleState
                                                                                                    /\ timer' = [timer EXCEPT !.armed = FALSE]
                                                                                                    /\ UNCHANGED timerSeq
                                                                                               ELSE /\ sy' = [sy EXCEPT !.absorbed = sy.absorbed + 1]
                                                                                                    /\ IF ~FixedDrainDeadline
                                                                                                          THEN /\ timerSeq' = timerSeq + 1
                                                                                                               /\ timer' = [armed |-> TRUE, seq |-> timerSeq', drain |-> TRUE]
                                                                                                          ELSE /\ TRUE
                                                                                                               /\ UNCHANGED << timer, 
                                                                                                                               timerSeq >>
                                                                                    ELSE /\ TRUE
                                                                                         /\ UNCHANGED << timer, 
                                                                                                         sy, 
                                                                                                         timerSeq >>
                                                              ELSE /\ TRUE
                                                                   /\ UNCHANGED << timer, 
                                                                                   sy, 
                                                                                   timerSeq >>
                                                        /\ UNCHANGED << link, 
                                                                        nextQid, 
                                                                        outcomes >>
          /\ ev' = NoEvent
          /\ UNCHANGED << tiling, batches, lookupErr, pauses, lateFired, 
                          started, dups, corrupts >>

World == /\ ev = NoEvent
         /\ \/ /\ started < MaxAttempts
               /\ started' = started + 1
               /\ ev' = [NoEvent EXCEPT !.kind = "start", !.attempt = started']
               /\ UNCHANGED <<link, pauses, timer, lateFired, dups, corrupts>>
            \/ /\ link /= <<>>
               /\ ev' = [NoEvent EXCEPT !.kind = "msg", !.msg = Head(link)]
               /\ link' = Tail(link)
               /\ UNCHANGED <<pauses, timer, lateFired, started, dups, corrupts>>
            \/ /\ Stalls /\ link /= <<>>
               /\ link' = SelectSeq(link, LAMBDA x : x.q /= Head(link).q)
               /\ UNCHANGED <<pauses, timer, lateFired, ev, started, dups, corrupts>>
            \/ /\ timer.armed /\ TimerMayFire
               /\ IF link /= <<>>
                     THEN /\ pauses' = [pauses EXCEPT ![Head(link).q] = pauses[Head(link).q] + 1]
                     ELSE /\ TRUE
                          /\ UNCHANGED pauses
               /\ ev' = [NoEvent EXCEPT !.kind = "timer", !.seq = timer.seq]
               /\ timer' = [timer EXCEPT !.armed = FALSE]
               /\ UNCHANGED <<link, lateFired, started, dups, corrupts>>
            \/ /\ \E s \in (lateFired + 1)..timerSeq:
                    /\ ~(timer.armed /\ s = timer.seq)
                    /\ lateFired' = s
                    /\ ev' = [NoEvent EXCEPT !.kind = "timer", !.seq = s]
               /\ UNCHANGED <<link, pauses, timer, started, dups, corrupts>>
            \/ /\ dups < MaxDups /\ link /= <<>>
               /\ dups' = dups + 1
               /\ link' = <<Head(link)>> \o link
               /\ UNCHANGED <<pauses, timer, lateFired, ev, started, corrupts>>
            \/ /\ corrupts < MaxCorrupts /\ link /= <<>>
               /\ ~Head(link).isEnd /\ ~Head(link).bad
               /\ corrupts' = corrupts + 1
               /\ link' = [link EXCEPT ![1].bad = TRUE]
               /\ UNCHANGED <<pauses, timer, lateFired, ev, started, dups>>
         /\ UNCHANGED << tiling, batches, lookupErr, sy, nextQid, timerSeq, 
                         outcomes >>

Next == Syncer \/ World

Spec == /\ Init /\ [][Next]_vars
        /\ WF_vars(Syncer)
        /\ WF_vars(World)

\* END TRANSLATION

(***************************************************************************)
(* The properties. An invariant is a formula about a single state that     *)
(* must hold in every reachable state. TLC reports the first state that    *)
(* breaks one, with the shortest behavior that reaches it, since it        *)
(* explores breadth first.                                                 *)
(***************************************************************************)

TypeOK ==
    /\ sy.st \in {"Idle", "AwaitingRange", "QueryingSCIDs", "Draining"}
    /\ started \in 0..MaxAttempts
    /\ nextQid \in 0..MaxQid
    /\ \A q \in 1..MaxQid : pauses[q] \in Nat
    \* Outside Idle a timer is always armed, since every state but Idle is
    \* waiting on the peer.
    /\ ev = NoEvent => (sy.st /= "Idle" <=> timer.armed)

(***************************************************************************)
(* Every event passes through ev before the syncer handles it, so a        *)
(* property of how the syncer handles an event can be stated about the     *)
(* state in which that event is pending. Accepts is the set of messages    *)
(* the syncer folds into its attempt: a valid range reply in AwaitingRange *)
(* and an end marker in QueryingSCIDs.                                     *)
(***************************************************************************)
Accepts(s, m) ==
    \/ s.st = "AwaitingRange" /\ ~m.isEnd /\ Valid(s, m)
    \/ s.st = "QueryingSCIDs" /\ m.isEnd

Pending(kind) == ev.kind = kind

\* GSS-012: every reply the syncer credits answers the attempt's own query.
NoCrossAttemptCredit ==
    Pending("msg") /\ Accepts(sy, ev.msg) => ev.msg.q = sy.qid

\* GSS-013: a range phase only completes on one whole stream, the replies
\* of a single query from its first reply on, in order.
IsWholeStream(cr) ==
    \A k \in DOMAIN cr : cr[k].q = cr[1].q /\ cr[k].i = k - 1

WholeStreamCredit ==
    LET m == ev.msg IN
    Pending("msg") /\ sy.st = "AwaitingRange" /\ Accepts(sy, m)
        /\ RangeDone(Fold(sy, m), m)
        => IsWholeStream(Fold(sy, m).cr)

(***************************************************************************)
(* GSS-012: the syncer never sends a query while one of the same kind is   *)
(* still being answered. The peer's answer goes on the link when the query *)
(* is sent, and a stall removes the rest of it, so the property is         *)
(* that the link never carries two streams of the same kind at once. The   *)
(* set {e : x \in S} is the image of S, like a map over a slice.           *)
(***************************************************************************)
StreamsOnLink(isEnd) ==
    {link[k].q : k \in {j \in DOMAIN link : link[j].isEnd = isEnd}}

OneOutstandingQuery ==
    /\ Cardinality(StreamsOnLink(FALSE)) <= 1
    /\ Cardinality(StreamsOnLink(TRUE)) <= 1

\* GSS-002, safety half: no attempt gets two outcomes, and only a started
\* attempt gets one.
AtMostOneOutcome ==
    \A a \in 1..MaxAttempts :
        /\ Len(outcomes[a]) <= 1
        /\ outcomes[a] /= <<>> => a <= started

\* GSS-002, the quiescence half: once the peer has nothing in flight and
\* every armed timer has fired, the syncer is Idle and every attempt has
\* its outcome.
Quiescent == ev = NoEvent /\ link = <<>> /\ ~timer.armed

QuiescentIdle ==
    Quiescent =>
        /\ sy.st = "Idle"
        /\ \A a \in 1..started : Len(outcomes[a]) = 1

\* GSS-009: with a prompt honest peer no attempt fails with a peer fault.
PromptPeerNeverFaulted ==
    \A a \in 1..MaxAttempts :
        \A k \in 1..Len(outcomes[a]) : outcomes[a][k] /= "peerFault"

(***************************************************************************)
(* A liveness property is about whole behaviors, not single states. P ~> Q *)
(* ("leads to") says that whenever P holds, Q holds then or later. It      *)
(* needs fairness: without the "fair" on both processes, a behavior that   *)
(* just stops, with an attempt open, would be a legal behavior of Spec.    *)
(***************************************************************************)
EveryAttemptEnds ==
    \A a \in 1..MaxAttempts : (started >= a) ~> (outcomes[a] /= <<>>)

=============================================================================
