{
  "version": 1,
  "id": "ready-replay",
  "config": {
    "max_parts": 2,
    "max_attempts": 2,
    "hold_blocks": 40,
    "recovery_blocks": 6,
    "expiry_safety_blocks": 1,
    "max_reorg_depth": 6
  },
  "relay": {
    "expected_total_msat": 100,
    "downstream_msat": 90,
    "required_cltv": 600,
    "start_height": 500
  },
  "invariants": [
    "NoDuplicateForwardAttempt",
    "NoForwardAfterTerminal",
    "TerminalResolvesAcceptedParts"
  ],
  "events": [
    {
      "seq": 0,
      "event": "add_part",
      "payload": {
        "channel_id": 1,
        "htlc_id": 1,
        "amount_msat": 100,
        "cltv": 700
      },
      "expected": {
        "state": "ready",
        "collected_msat": 100,
        "dispatch_claimed": true,
        "dispatch_scheduled": true,
        "actions": [
          {
            "kind": "payment_ready",
            "amount_msat": 100
          }
        ]
      }
    },
    {
      "seq": 1,
      "event": "notify_ready",
      "expected": {
        "state": "ready",
        "dispatch_claimed": false,
        "dispatch_scheduled": true
      }
    },
    {
      "seq": 2,
      "event": "restart",
      "expected": {
        "state": "ready",
        "dispatch_claimed": false,
        "dispatch_scheduled": false
      }
    },
    {
      "seq": 3,
      "event": "notify_ready",
      "expected": {
        "state": "ready",
        "dispatch_claimed": true,
        "dispatch_scheduled": true
      }
    },
    {
      "seq": 4,
      "event": "notify_ready",
      "expected": {
        "state": "ready",
        "dispatch_claimed": false,
        "dispatch_scheduled": true
      }
    },
    {
      "seq": 5,
      "event": "begin_attempt",
      "expected": {
        "state": "paying",
        "attempts": 1,
        "active_attempt": 1,
        "dispatch_scheduled": false,
        "actions": [
          {
            "kind": "start_downstream",
            "attempt_id": 1,
            "amount_msat": 90
          }
        ]
      }
    },
    {
      "seq": 6,
      "event": "begin_attempt",
      "expected": {
        "state": "paying",
        "attempts": 1,
        "active_attempt": 1,
        "dispatch_scheduled": false,
        "error_contains": "dispatch is not scheduled"
      }
    },
    {
      "seq": 7,
      "event": "attempt_success",
      "payload": {
        "attempt_id": 1
      },
      "expected": {
        "state": "succeeded",
        "attempts": 1,
        "active_attempt": 0,
        "actions": [
          {
            "kind": "fulfill_part",
            "channel_id": 1,
            "htlc_id": 1,
            "amount_msat": 100
          }
        ]
      }
    }
  ]
}
